# Contact form + MCP contact_selvin tool
RESEND_API_KEY=

# Ask Selvin + prompt-injection challenge: any OpenAI-compatible endpoint.
# Free tiers, no credit card (directory: https://github.com/freellms/free-llm-api-keys):
#   Groq        https://api.groq.com/openai/v1                           llama-3.3-70b-versatile
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai  gemini-2.5-flash
#   Cerebras    https://api.cerebras.ai/v1                               llama-3.3-70b
#   Mistral     https://api.mistral.ai/v1                                mistral-small-latest
#   OpenRouter  https://openrouter.ai/api/v1                             <model>:free
#   NVIDIA NIM  https://integrate.api.nvidia.com/v1                      meta/llama-3.3-70b-instruct
# Leave unset: /ask answers in retrieval-only mode and /challenge shows as offline.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional second provider, tried when the first errors or is rate-limited.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# TypeSafe decision models (https://docs.typesafe.ai): calibrated yes/no gates for
# /ask (on-topic, injection) and the /challenge level-5 guard. Optional; without it
# /ask uses a BM25 coverage gate and the guard asks the chat model.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Long random string; derives the challenge passwords (they are not in the repo).
CHALLENGE_SALT=
